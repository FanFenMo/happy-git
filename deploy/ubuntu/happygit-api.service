[Unit]
Description=HappyGit cloud identity and ingest API
After=network-online.target
Wants=network-online.target

[Service]
User=happygit
Group=happygit
EnvironmentFile=/etc/happygit/cloud.env
WorkingDirectory=/opt/happygit
ExecStart=/opt/happygit/runtime/java17/bin/java -XX:MaxRAMPercentage=70 -jar /opt/happygit/happygit-server.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
