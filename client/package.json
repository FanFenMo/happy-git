{
  "name": "happygit-client",
  "private": true,
  "version": "1.0.0",
  "description": "HappyGit - 开源项目个性化推荐与展示系统",
  "author": "FanFenMo",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "prebuild": "node scripts/prepare-config.mjs",
    "dev": "node scripts/prepare-config.mjs && vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:win": "node scripts/build-win.mjs",
    "app:run": "npm run build && electron electron/main.cjs",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap add android",
    "cap:ios": "npm run build && cap add ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
