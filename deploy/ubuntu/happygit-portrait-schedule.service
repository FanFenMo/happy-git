[Unit]
Description=Queue portraits for the active HappyGit model
After=network-online.target

[Service]
Type=oneshot
User=happygit
Group=happygit
EnvironmentFile=/opt/happygit/conf/platform.env
WorkingDirectory=/opt/happygit
ExecStart=/opt/happygit/bin/data-platform learning-schedule
NoNewPrivileges=true
