# Install privately as /etc/happygit/cloud.env (0600), never commit actual values.
SPRING_PROFILES_ACTIVE=cloud
HG_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/happygit?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
HG_MYSQL_USER=happygit
HG_MYSQL_PASSWORD=
HG_CLOUD_ADMIN_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optionally use a separate OAuth app; otherwise the general credentials above apply.
# GITHUB_CLOUD_CLIENT_ID=
# GITHUB_CLOUD_CLIENT_SECRET=
GITHUB_CLOUD_CALLBACK_URL=https://your-domain/api/v2/auth/github/callback
GITHUB_CALLBACK_URL=https://your-domain/api/auth/github/callback

# Add these two values to the data-platform worker's private platform.env too.
HG_CLOUD_API_URL=https://your-domain
# HG_CLOUD_ADMIN_TOKEN must match the API's service token (at least 32 characters).
